    {
        "id": "5cf7c57528ef2ddc",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Extraction HEX + ID",
        "func": "// On récupère la chaine HEX spécifiquement dans l'objet\nlet hexString = \"\";\n\nif (msg.payload && msg.payload.hex) {\n    hexString = msg.payload.hex;\n} else if (typeof msg.payload === 'string') {\n    hexString = msg.payload;\n}\n\n// Timestamp actuel (Date du serveur)\nconst timestamp = Math.floor(Date.now() / 1000);\n\n// ID (soit celui du message, soit 1 par défaut)\nconst id = msg.payload.id || 1;\n\n// Mise à jour du payload pour la suite\nmsg.payload = {\n    hex: hexString,\n    id: id,\n    timestamp: timestamp,\n    rssi: msg.payload.rssi // On garde le RSSI pour info\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 320,
        "wires": [
            [
                "5e16c92c925a1b2c"
            ]
        ]
    },
    {
        "id": "5e16c92c925a1b2c",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Déchiffrer XTEA",
        "func": "// ========== CLE XTEA ==========\n// VERIFIEZ QUE CETTE CLE EST IDENTIQUE A L'ARDUINO\nconst XTEA_KEY = [0xA1B2C3D4, 0xE5F67890, 0x1A2B3C4D, 0x5E6F7809];\n\n// ========== ALGORYTHME ==========\nfunction xteaDec(v) {\n    let v0 = v[0], v1 = v[1];\n    const delta = 0x9E3779B9;\n    let sum = delta * 32;\n    \n    for (let i = 0; i < 32; i++) {\n        v1 -= (((v0 << 4) ^ (v0 >>> 5)) + v0) ^ (sum + XTEA_KEY[(sum >>> 11) & 3]);\n        v1 = v1 >>> 0;\n        sum -= delta;\n        sum = sum >>> 0;\n        v0 -= (((v1 << 4) ^ (v1 >>> 5)) + v1) ^ (sum + XTEA_KEY[sum & 3]);\n        v0 = v0 >>> 0;\n    }\n    return [v0, v1];\n}\n\nfunction decryptMessage(hex) {\n    if (!hex || typeof hex !== 'string') return \"\";\n    let out = \"\";\n    \n    for (let i = 0; i < hex.length; i += 16) {\n        let sub = hex.substring(i, i + 16);\n        if (sub.length < 16) break;\n        \n        let b = [\n            parseInt(sub.substring(0, 8), 16),\n            parseInt(sub.substring(8, 16), 16)\n        ];\n        \n        b = xteaDec(b);\n        \n        // Conversion en caractères\n        for (let k = 0; k < 2; k++) {\n            for (let j = 0; j < 4; j++) {\n                // Note: Si le résultat est du charabia, essayez de changer\n                // (j * 8) en ((3-j) * 8) ici (Endianness)\n                let byte = (b[k] >>> (j * 8)) & 0xFF;\n                if (byte !== 0) out += String.fromCharCode(byte);\n            }\n        }\n    }\n    return out.trim();\n}\n\nfunction extractValue(data, key) {\n    if (!data) return null;\n    const s = data.indexOf(key);\n    if (s === -1) return null;\n    const start = s + key.length;\n    let end = data.indexOf(';', start);\n    if (end === -1) end = data.length;\n    return data.substring(start, end);\n}\n\n// ========== EXECUTION ==========\ntry {\n    const decrypted = decryptMessage(msg.payload.hex);\n    \n    // Extraction des valeurs avec sécurité (|| 0)\n    msg.payload.decrypted_raw = decrypted;\n    msg.payload.temperature = parseFloat(extractValue(decrypted, \"T=\"));\n    msg.payload.humidite = parseFloat(extractValue(decrypted, \"H=\"));\n    msg.payload.sol = parseInt(extractValue(decrypted, \"S=\"));\n    msg.payload.lumiere = parseInt(extractValue(decrypted, \"L=\"));\n\n    // Vérification si le décodage a marché\n    msg.payload.success = !isNaN(msg.payload.temperature);\n    \n    return msg;\n} catch (e) {\n    node.error(\"Erreur XTEA: \" + e.message);\n    return null;\n}",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 320,
        "wires": [
            [
                "f89ed0b5c7679b5f",
                "792d070f2c5106ce"
            ]
        ]
    },
    {
        "id": "c1b03763374f0eb9",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Formatage pour InfluxDB",
        "func": "const d = msg.payload;\n\n// 1. Sécurité : Si le déchiffrement a échoué, on n'envoie RIEN à la base de données\n// pour éviter de polluer les graphs avec des 0 ou des erreurs.\nif (!d.success) {\n    return null;\n}\n\n// 2. Préparation des données (Variables venant du noeud précédent)\n// On s'assure que ce sont des nombres\nconst temp = parseFloat(d.temperature);\nconst hum = Number(d.humidite);\nconst lum = Number(d.lumiere);\nconst hum_sol = Number(d.sol);\nconst rssi = Number(d.rssi) || 0;\n\n// 3. Construction du message InfluxDB (Format Array of Objects)\n// Cela permet de définir précisément les TAGS et les FIELDS\n\nif (!d.success) return null;\n\n// On prépare l'objet de données\nconst influxData = {\n    temperature: parseFloat(d.temperature),\n    humidite: Number(d.humidite),\n    luminosite: Number(d.lumiere),\n    humidite_sol: Number(d.sol),\n    rssi: Number(d.rssi) || 0\n};\n\nconst influxTags = {\n    id_plante: d.id.toString(),\n    location: \"maison\"\n};\n\n// Voici le format exact attendu par le nœud quand le champ Measurement est vide :\nmsg.payload = influxData;      // Les \"Fields\"\nmsg.tags = influxTags;         // Les \"Tags\"\nmsg.measurement = \"monitor_plante\"; // Le nom de la table\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
        "y": 200,

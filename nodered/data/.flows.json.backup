    {
        "id": "792d070f2c5106ce",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Format Discord",
        "func": "const d = msg.payload;\n\n// Gestion des erreurs de lecture (NaN)\n// Si T=NaN, on affiche \"--\"\nconst temp = !isNaN(d.temperature) ? d.temperature : \"--\";\nconst hum = !isNaN(d.humidite) ? d.humidite : \"--\";\nconst sol = !isNaN(d.sol) ? d.sol : \"--\";\nconst lum = !isNaN(d.lumiere) ? d.lumiere : \"--\";\n\n// Timestamp\nconst date = new Date();\nconst dateStr = date.toLocaleString('fr-FR');\n\n// Logique couleur et emoji (seulement si données valides)\nlet color = 3447003; // Bleu par défaut\nlet etat = \"🟢 Données reçues\";\n\nif (temp !== \"--\") {\n    if (temp > 25) color = 15158332; \n    else if (temp < 18) color = 3066993;\n    \n    if (sol < 300 && sol !== \"--\") etat = \"🟡 Besoin d'eau\";\n}\n\nif (!d.success) {\n    etat = \"⚠️ Erreur Déchiffrement\";\n    color = 0x000000;\n}\n\n// Construction du message Discord\nmsg.payload = {\n    embeds: [{\n        title: \"🌿 Plante #\" + d.id,\n        description: \"**État:** \" + etat,\n        color: color,\n        fields: [\n            { name: \"🌡️ Temp\", value: temp + \"°C\", inline: true },\n            { name: \"💧 Humidité\", value: hum + \"%\", inline: true },\n            { name: \"🌱 Sol\", value: sol + \"\", inline: true },\n            { name: \"☀️ Lumière\", value: lum + \"\", inline: true },\n            { name: \"📡 RSSI\", value: (d.rssi || \"N/A\") + \"dBm\", inline: true }\n        ],\n        timestamp: date.toISOString()\n    }]\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",

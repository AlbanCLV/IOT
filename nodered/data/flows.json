    {
        "id": "format_influx",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Formatage pour InfluxDB",
        "func": "// On récupère et convertit les valeurs\nvar temp = parseFloat(msg.payload.temperature);\nvar hum = Number(msg.payload.humidite);\nvar lux = Number(msg.payload.luminosite);\nvar hum_sol = Number(msg.payload.humidite_sol);\n\n// Sécurité : si ce n'est pas un nombre, on arrête tout\nif (isNaN(temp) || isNaN(hum) || isNaN(lux) || isNaN(hum_sol)) {\n    return null;\n}\n\n// ON ENVOIE JUSTE LES VALEURS (Pas de \"measurement\", pas de \"fields\", pas de crochets [])\nmsg.payload = {\n    temperature: temp,\n    humidite: hum,\n    luminosite: lux,\n    humidite_sol: hum_sol\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
